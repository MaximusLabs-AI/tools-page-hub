# ---------------------------------------------------------------------------
# MaximusLabs Tools Hub — environment (PLACEHOLDERS ONLY, never commit real values)
# ---------------------------------------------------------------------------
# The app runs fully WITHOUT any of these using local seed data.
# Provide these later to switch the data layer to Sanity (no UI changes needed).

# Set to "sanity" to read from Sanity; anything else (or unset) uses local seed data.
DATA_SOURCE=local

# Sanity (only used when DATA_SOURCE=sanity)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-08-01
# Read token only needed for draft/preview content; public published content needs none.
SANITY_READ_TOKEN=
