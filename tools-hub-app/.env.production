# Committed on purpose: these are PUBLIC values (project id + dataset are exposed
# to the browser via NEXT_PUBLIC_*). No token here — the production dataset is
# public, so the app reads via the Sanity CDN with no credentials.
DATA_SOURCE=sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=asrqfhiu
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-08-01
